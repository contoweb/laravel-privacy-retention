{
    "preset": "laravel",
    "rules": {
        "align_multiline_comment": true,
        "array_indentation": true,
        "binary_operator_spaces": {
            "operators": {
                "=>": "align_single_space_minimal"
            }
        },
        "concat_space": {
            "spacing": "one"
        },
        "fully_qualified_strict_types": true,
        "new_with_braces": {
            "anonymous_class": false,
            "named_class": false
        },
        "phpdoc_align": true,
        "simplified_null_return": true
    },
    "exclude": [
        "config"
    ]
}

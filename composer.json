{
    "name": "contoweb/laravel-privacy-retention",
    "description": "Retention-based anonymization for Eloquent models — interface, trait, strategy enum and scheduler command.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "laravel/pint": "^1.27",
        "larastan/larastan": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "Contoweb\\PrivacyRetention\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contoweb\\PrivacyRetention\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Contoweb\\PrivacyRetention\\PrivacyRetentionServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": [
            "vendor/bin/phpunit"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "types:check": [
            "phpstan analyse"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

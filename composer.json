{
    "name": "contoweb/laravel-privacy-retention",
    "description": "Retention-based anonymization for Eloquent models — interface, trait, strategy enum and scheduler command.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Contoweb\\PrivacyRetention\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contoweb\\PrivacyRetention\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Contoweb\\PrivacyRetention\\PrivacyRetentionServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
